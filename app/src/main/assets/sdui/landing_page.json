            {
              "id": "promo_assured",
              "title": "CARS24 Assured — 140 point inspected",
              "background": "#2E7D32",
              "route": "assured_landing"
            },
            {
              "id": "promo_finance",
              "title": "Car loans from 9.4% interest",
              "background": "#1565C0",
              "route": "finance_landing"
            },
            {
              "id": "promo_sell",
