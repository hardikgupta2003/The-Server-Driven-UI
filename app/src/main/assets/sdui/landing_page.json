            { "id": "hatchback", "label": "Hatchback", "value": "hatchback" },
            { "id": "muv", "label": "MUV", "value": "muv" }
          ]
        },
        "actions": {
          "onSelect": {
            "type": "updateState",
            "target": "selectedCategory",
            "payloadFromEvent": "value"
          }
        }
      },
