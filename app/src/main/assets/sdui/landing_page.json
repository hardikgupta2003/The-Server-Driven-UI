      {
        "id": "cta_check_emi",
        "type": "Button",
        "style": { "margin": [16, 8, 16, 8] },
        "props": { "label": "Calculate EMI — Hyundai Creta ₹13.75L" },
        "actions": {
          "onClick": { "type": "openSheet", "target": "sheet_emi_creta" }
        },
        "children": [
          {
            "id": "sheet_emi_creta",
            "type": "Column",
            "style": { "padding": [20, 20, 20, 24] },
            "props": {},
            "children": [
              {
                "id": "sheet_title",
                "type": "Text",
                "props": { "text": "Hyundai Creta SX 2021 · ₹13.75 Lakh", "size": 18, "weight": "bold" }
              },
              { "id": "sheet_spacer_1", "type": "Spacer", "props": { "height": 12 } },
              {
                "id": "sheet_tenure_label",
                "type": "Text",
                "props": { "text": "Choose loan tenure", "size": 13, "color": "#616161" }
              },
              { "id": "sheet_spacer_2", "type": "Spacer", "props": { "height": 8 } },
              {
                "id": "sheet_tenure_chip_row",
                "type": "ChipRow",
                "style": { "padding": [0, 0, 0, 0] },
                "props": {
                  "defaultSelected": "36",
                  "items": [
                    { "id": "t12", "label": "12 months", "value": "12" },
                    { "id": "t36", "label": "36 months", "value": "36" },
                    { "id": "t60", "label": "60 months", "value": "60" },
                    { "id": "t84", "label": "84 months", "value": "84" }
                  ]
                },
                "actions": {
                  "onSelect": {
                    "type": "updateState",
                    "target": "selectedTenure",
                    "payloadFromEvent": "value"
                  }
                }
              },
              { "id": "sheet_spacer_3", "type": "Spacer", "props": { "height": 16 } },
              {
                "id": "sheet_emi_result",
                "type": "Column",
                "props": {},
                "dataBinding": {
                  "stateKey": "selectedTenure",
                  "variants": {
                    "default": [
                      { "id": "emi_default", "type": "Text", "props": { "text": "EMI: ₹44,150 / month", "size": 22, "weight": "bold", "color": "#2E7D32" } }
                    ],
                    "12": [
                      { "id": "emi_12", "type": "Text", "props": { "text": "EMI: ₹1,20,850 / month", "size": 22, "weight": "bold", "color": "#2E7D32" } }
